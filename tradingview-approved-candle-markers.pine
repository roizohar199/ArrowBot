    array.set(archiveFrame, 2, archiveSeq)
    array.set(archiveFrame, 3, timenow)
    array.set(archiveFrame, 4, totalRows > 0 ? matrix.get(selectedArchive, 0, 0) + archiveDuration : time)
    array.set(archiveFrame, 5, archiveDuration)
    array.set(archiveFrame, 6, totalRows)
    array.set(archiveFrame, 7, repairRow >= 0 ? repairRow : page)
    array.set(archiveFrame, 8, archiveMeta)
    for index = 0 to 34
        float value = -1
        if compact
            int row = rowStart + int(math.floor(index / 3))
            int column = index % 3
            if index < 33 and row < totalRows
                value := column == 0 ? matrix.get(selectedArchive, row, 0) / 60000 * 134217728 + matrix.get(selectedArchive, row, 6) : column == 1 ? matrix.get(selectedArchive, row, 1) * 67108864 + matrix.get(selectedArchive, row, 2) : matrix.get(selectedArchive, row, 3) * 67108864 + matrix.get(selectedArchive, row, 4)
        else
            int row = page * 5 + int(math.floor(index / 7))
            int column = index % 7
            value := row < totalRows ? matrix.get(selectedArchive, row, column) : -1
        array.set(archiveFrame, 9 + index, value)
    archiveHashA := 0
    archiveHashB := 0
    for index = 0 to 43
        int value = int(array.get(archiveFrame, index))
        archiveHashA := (archiveHashA * 65599 + ((value % 1000000007) + 1000000007) % 1000000007) % 1000000007
        archiveHashB := (archiveHashB * 131071 + ((value % 1000000009) + 1000000009) % 1000000009) % 1000000009
    array.set(archiveFrame, 44, archiveHashA)
    array.set(archiveFrame, 45, archiveHashB)
    array.set(archiveFrame, 46, archiveSeq)
    archiveLastAt := timenow
