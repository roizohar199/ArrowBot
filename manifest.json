{
  "manifest_version": 3,
  "name": "Arrow Observation Experiment",
  "version": "0.32.1",
  "description": "Visual candle observation and versioned candlestick/price-action research alerts with market context, confirmation and risk checks.",
  "minimum_chrome_version": "118",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.tradingview.com/*",
    "https://tradingview.com/*"
  ],
  "optional_host_permissions": ["https://api.telegram.org/*"],
  "action": {
    "default_title": "Arrow · נרות OHLC חיים לצד הגרף"
  },
  "side_panel": {
    "default_path": "live-ohlc.html?execution=user-managed"
  },
  "background": {
    "service_worker": "launcher.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
